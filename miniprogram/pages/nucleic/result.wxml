<view class="page-nucleic-result">
  <view class="container">
    <view class="card nres-head">
      <view class="nres-check">✓</view>
      <view class="nres-title">检测预约成功</view>
      <view class="text-muted nres-sub">可在下方核对本单信息</view>
    </view>

    <view wx:if="{{detail}}" class="card">
      <view class="nres-row">
        <text class="nres-label">预约单号</text>
        <text class="nres-mono">{{detail.orderNo}}</text>
      </view>
      <view class="nres-row">
        <text class="nres-label">就诊人</text>
        <text class="nres-value">{{detail.patientName}}</text>
      </view>
      <view class="nres-row">
        <text class="nres-label">检测日期</text>
        <text class="nres-value">{{detail.appointmentDate}}</text>
      </view>
      <view class="nres-row">
        <text class="nres-label">当前状态</text>
        <text class="nres-status nres-status-{{detail.statusTone}}">{{detail.statusLabel}}</text>
      </view>
    </view>

    <button class="btn-primary nres-report-btn" bindtap="onGoReport">查看检测报告</button>
    <button class="btn-outline nres-list-btn" bindtap="onGoList">我的核酸预约记录</button>
    <button class="btn-outline nres-home-btn" bindtap="onBackHome">返回首页</button>

    <view class="text-muted nres-note">
      首版仅演示预约流程，不含实际采样与检测。
    </view>
  </view>
</view>
