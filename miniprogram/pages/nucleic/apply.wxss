.na-empty {
  padding: 48rpx 0;
  text-align: center;
}

.na-empty .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.na-empty .empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.na-empty .empty-desc {
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.na-empty-btn {
  width: 60%;
}

.na-patient {
  position: relative;
  padding: 24rpx 60rpx 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.na-patient:last-of-type {
  border-bottom: none;
}

.na-patient-main {
  display: flex;
  align-items: center;
}

.na-patient-name {
  font-size: 30rpx;
  color: #1f2937;
  margin-right: 12rpx;
}

.na-patient-relation {
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.na-patient-card {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.na-patient-on {
  background: #f8fafc;
}

.na-patient-check {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #2563eb;
  font-size: 32rpx;
  font-weight: 600;
}

.na-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.na-row-label {
  font-size: 26rpx;
  color: #64748b;
}

.na-row-value {
  font-size: 30rpx;
  color: #1f2937;
}

.na-row-placeholder {
  color: #cbd5e1;
}

.na-tip {
  font-size: 22rpx;
  line-height: 1.6;
}

.na-next {
  margin-top: 32rpx;
}
