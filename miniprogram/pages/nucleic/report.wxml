<view class="page-nucleic-report">
  <view class="container">
    <view wx:if="{{detail}}" class="card">
      <view class="nr-head">
        <text class="nr-title">检测信息</text>
        <text class="nr-status nr-status-{{detail.statusTone}}">{{detail.statusLabel}}</text>
      </view>
      <view class="nr-row">
        <text class="nr-label">预约单号</text>
        <text class="nr-mono">{{detail.orderNo}}</text>
      </view>
      <view class="nr-row">
        <text class="nr-label">就诊人</text>
        <text class="nr-value">{{detail.patientName}}</text>
      </view>
      <view class="nr-row">
        <text class="nr-label">检测日期</text>
        <text class="nr-value">{{detail.appointmentDate}}</text>
      </view>
    </view>

    <view wx:if="{{detail}}" class="card">
      <view class="section-title">检测报告</view>
      <view wx:if="{{detail.issued}}" class="nr-body">{{detail.report}}</view>
      <view wx:else class="nr-empty">
        <view class="nr-empty-icon">⏳</view>
        <view class="nr-empty-title">报告未出</view>
        <view class="text-muted nr-empty-desc">
          首版仅演示预约流程，不含实际采样与检测，故不会出具报告内容。
        </view>
      </view>
    </view>

    <button class="btn-primary nr-list-btn" bindtap="onGoList">返回核酸预约记录</button>
    <button class="btn-outline nr-home-btn" bindtap="onBackHome">返回首页</button>
  </view>
</view>
