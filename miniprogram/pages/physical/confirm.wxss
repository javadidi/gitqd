.ppc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ppc-label {
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.ppc-value {
  font-size: 28rpx;
  color: #1f2937;
  text-align: right;
}

.ppc-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #dc2626;
}

.ppc-placeholder {
  color: #cbd5e1;
}

.ppc-note {
  font-size: 22rpx;
  line-height: 1.7;
  padding-top: 20rpx;
}

.ppc-next {
  margin-top: 32rpx;
}
