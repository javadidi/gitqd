.rd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.rd-doctor {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.rd-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.rd-status-pending {
  color: #0284c7;
  background: #e0f2fe;
}

.rd-status-completed {
  color: #71717a;
  background: #f4f4f5;
}

.rd-status-cancelled {
  color: #e11d48;
  background: #ffe4e6;
}

.rd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #1f2937;
}

.rd-row:last-child {
  border-bottom: none;
}

.rd-label {
  color: #9ca3af;
  font-size: 26rpx;
}

.rd-fee {
  color: #dc2626;
  font-weight: 600;
}

.rd-order {
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.rd-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}

.rd-cancel {
  margin-top: 32rpx;
  color: #e11d48;
  border-color: #fecdd3;
}

.rd-back {
  margin-top: 20rpx;
}
