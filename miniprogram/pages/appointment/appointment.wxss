.page-appointment {
  padding-bottom: 40rpx;
}

.empty-card {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.login-empty-btn,
.dept-empty-btn {
  width: 60%;
}

.dept-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dept-search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.dept-search-clear {
  color: #2563eb;
  font-size: 26rpx;
  padding: 8rpx 4rpx;
}

.dept-card {
  padding: 28rpx 24rpx;
}

.dept-name {
  font-size: 34rpx;
  font-weight: 600;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.dept-lines {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dept-value {
  font-size: 26rpx;
  color: #555;
}

.dept-intro {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
