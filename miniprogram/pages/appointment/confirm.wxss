.cf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cf-row:last-child {
  border-bottom: none;
}

.cf-label {
  font-size: 26rpx;
  color: #9ca3af;
}

.cf-value {
  font-size: 28rpx;
  color: #1f2937;
}

.cf-value-row {
  display: flex;
  align-items: center;
}

.cf-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.cf-change {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #2563eb;
}

.cf-row-fee {
  border-bottom: none;
}

.cf-fee {
  font-size: 34rpx;
  font-weight: 600;
  color: #dc2626;
}

.cf-submit {
  margin-top: 32rpx;
}

.cf-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #cbd5e1;
}
