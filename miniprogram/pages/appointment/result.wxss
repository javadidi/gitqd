.res-head {
  text-align: center;
  padding: 40rpx 24rpx;
}

.res-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50%;
  margin: 0 auto 16rpx;
  font-size: 44rpx;
  color: #ffffff;
}

.res-icon-ok {
  background: #10b981;
}

.res-icon-warn {
  background: #f59e0b;
}

.res-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.res-status {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.res-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.res-order {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1f2937;
  word-break: break-all;
}

.res-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #1f2937;
}

.res-row:last-child {
  border-bottom: none;
}

.res-fee {
  color: #dc2626;
  font-weight: 600;
}

.res-btn {
  margin-top: 24rpx;
}
