<view class="page-apt-notice">
  <view class="container">
    <view class="card apt-slot-card">
      <view class="apt-slot-title">{{doctorName || '—'}} · {{departmentName || '—'}}</view>
      <view class="apt-slot-line">{{date}} {{slotLabel}}</view>
    </view>

    <view class="card">
      <!-- 标题也来自接口：后台那张表里 title 是可编辑的，写死在页面上就会"改了没生效" -->
      <view class="section-title">{{noticeTitle}}</view>
      <view wx:for="{{lines}}" wx:key="*this" class="notice-item">
        <view class="notice-item-index">{{index + 1}}</view>
        <view class="notice-item-body">
          <view class="notice-item-title">{{item}}</view>
        </view>
      </view>
      <view wx:if="{{noticeLoading}}" class="text-muted apt-notice-loading">须知加载中…</view>
      <view wx:elif="{{noticeError}}" class="text-muted apt-notice-error">{{noticeError}}</view>
      <view wx:elif="{{lines.length === 0}}" class="text-muted apt-notice-empty">
        医院还没有发布预约须知内容
      </view>
      <!-- 正文来自 appointment_notice 表（T27 建），一行一条；本页不再自带条款。 -->
    </view>

    <button class="btn-primary apt-next" bindtap="onNext">已阅读，下一步</button>
  </view>
</view>
