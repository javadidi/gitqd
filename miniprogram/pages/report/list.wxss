.rl-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.rl-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.rl-sub {
  font-size: 22rpx;
}

.rl-empty {
  padding: 80rpx 0;
  text-align: center;
}

.rl-empty .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.rl-empty .empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.rl-empty .empty-desc {
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.rl-backtype-btn,
.rl-home-btn {
  width: 60%;
}

.rl-home-btn {
  margin-top: 20rpx;
}

.rl-card {
  padding: 24rpx;
}

.rl-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rl-patient {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.rl-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  color: #1d4ed8;
  background: #dbeafe;
}

.rl-no {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-family: Menlo, Consolas, monospace;
  color: #374151;
}

.rl-foot {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rl-time {
  font-size: 24rpx;
}

.rl-arrow {
  font-size: 36rpx;
  color: #9ca3af;
}
