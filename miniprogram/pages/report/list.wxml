<view class="page-report-list">
  <view class="container">
    <view class="card rl-head">
      <text class="rl-title">{{typeLabel}}</text>
      <text class="text-muted rl-sub">共 {{rows.length}} 份</text>
    </view>

    <view wx:if="{{!loading && rows.length === 0}}" class="rl-empty">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">暂无{{typeLabel}}</view>
      <view class="text-muted empty-desc">报告由医院相关科室出具，出结果后会出现在这里；也可以先看另一类报告</view>
      <button class="btn-outline rl-backtype-btn" bindtap="onBackToType">换一类报告</button>
      <button class="btn-outline rl-home-btn" bindtap="onGoHome">回首页</button>
    </view>

    <view
      wx:for="{{rows}}"
      wx:key="reportId"
      class="card rl-card"
      data-id="{{item.reportId}}"
      bindtap="onOpen"
    >
      <view class="rl-card-head">
        <text class="rl-patient">{{item.patientName}}</text>
        <text class="rl-type">{{item.typeLabel}}</text>
      </view>
      <view class="rl-no">{{item.reportNo}}</view>
      <view class="rl-foot">
        <text class="text-muted rl-time">{{item.timeText}}</text>
        <text class="rl-arrow">›</text>
      </view>
    </view>
  </view>
</view>
