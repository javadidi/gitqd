.page-patient {
  padding-bottom: 40rpx;
}

.empty-card {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 60%;
}

.patient-card {
  padding: 28rpx 24rpx;
}

.patient-name-row {
  gap: 16rpx;
}

.patient-name {
  font-size: 34rpx;
  font-weight: 600;
}

.relation-tag {
  font-size: 22rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.08);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.patient-lines {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.patient-value {
  font-size: 26rpx;
  color: #555;
}

.add-btn {
  width: 100%;
}

.patient-actions {
  margin-top: 20rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: flex-end;
}

.delete-link {
  /* 命中区靠 padding 撑开：24rpx 的文字裸着很难点中（T06-F 折叠按钮踩过的坑） */
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  /* danger = PRD §2.1 的 rose-600，与管理端 StatusBadge 同一个语义色 */
  color: #e11d48;
}
