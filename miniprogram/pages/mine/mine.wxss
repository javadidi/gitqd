.page-mine {
  padding-bottom: 40rpx;
}

.user-section {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  padding: 60rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.login-hint {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-detail .text-muted {
  color: rgba(255, 255, 255, 0.7);
}

.menu-group {
  margin-bottom: 24rpx;
  padding: 0 24rpx;
}

.menu-group-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.account-card {
  margin-bottom: 0;
}

.menu-left {
  gap: 20rpx;
}

.menu-right {
  gap: 12rpx;
}

.menu-value {
  font-size: 26rpx;
  color: #999;
}

.bind-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.bind-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fff;
}

.code-btn {
  height: 80rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.bind-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}

.bind-tip {
  margin-top: 16rpx;
  line-height: 1.6;
}
