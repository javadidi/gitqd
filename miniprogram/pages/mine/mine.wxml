<view class="page-mine">
  <!-- 用户信息区 -->
  <view class="user-section">
    <view wx:if="{{isLoggedIn}}" class="user-info" bindtap="onEditNickname">
      <view class="user-avatar">
        <text>👤</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{profile.nickname || '未设置昵称'}}</text>
        <text class="text-muted">{{profile.hasPhone ? profile.phone : '未绑定手机号'}}</text>
      </view>
    </view>
    <view wx:else class="user-info" bindtap="onLoginTap">
      <view class="user-avatar">
        <text>👤</text>
      </view>
      <view class="user-detail">
        <text class="login-hint">点击登录</text>
        <text class="text-muted">登录后享受更多服务</text>
      </view>
    </view>
  </view>

  <!-- 账号设置（T07） -->
  <view wx:if="{{isLoggedIn}}" class="menu-group">
    <view class="menu-group-title">账号设置</view>
    <view class="card account-card">
      <view class="menu-item" bindtap="onEditNickname">
        <view class="flex-row menu-left">
          <text class="menu-icon">✏️</text>
          <text class="menu-label">修改昵称</text>
        </view>
        <view class="flex-row menu-right">
          <text class="menu-value">{{profile.nickname || '未设置'}}</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
      <view class="menu-item">
        <view class="flex-row menu-left">
          <text class="menu-icon">📱</text>
          <text class="menu-label">手机号</text>
        </view>
        <view class="flex-row menu-right">
          <text class="menu-value">{{profile.hasPhone ? profile.phone : '未绑定'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 手机号绑定（T07） -->
  <view wx:if="{{isLoggedIn && !profile.hasPhone}}" class="menu-group">
    <view class="menu-group-title">手机号绑定</view>
    <view class="card account-card">
      <view class="bind-row">
        <input
          class="bind-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="bind-row">
        <input
          class="bind-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          value="{{smsCode}}"
          bindinput="onCodeInput"
        />
        <button
          class="btn-outline code-btn"
          size="mini"
          disabled="{{sending || countdown > 0}}"
          bindtap="onSendCode"
        >
          {{countdown > 0 ? countdown + 's 后重发' : '获取验证码'}}
        </button>
      </view>
      <button class="btn-primary bind-btn" loading="{{binding}}" bindtap="onBindPhone">
        绑定手机号
      </button>
      <view class="bind-tip">
        <text class="text-muted">当前为开发环境，验证码打印在后端日志中，不会真实下发短信</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view wx:for="{{menuItems}}" wx:key="group" class="menu-group">
    <view class="menu-group-title">{{item.group}}</view>
    <view class="card account-card">
      <view
        wx:for="{{item.items}}"
        wx:for-item="menuItem"
        wx:key="label"
        class="menu-item menu-item-{{menuItem.key}}"
        data-url="{{menuItem.url}}"
        data-label="{{menuItem.label}}"
        bindtap="onMenuTap"
      >
        <view class="flex-row menu-left">
          <text class="menu-icon">{{menuItem.icon}}</text>
          <text class="menu-label">{{menuItem.label}}</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
