.ivd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.ivd-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.ivd-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.ivd-status-ok {
  color: #16a34a;
  background: #dcfce7;
}

.ivd-status-pending {
  color: #d97706;
  background: #fef3c7;
}

.ivd-amount {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #dc2626;
}

.ivd-items {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f5f9;
}

.ivd-item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.ivd-item-name {
  color: #374151;
}

.ivd-item-amount {
  color: #1f2937;
}

.ivd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f8fafc;
  font-size: 26rpx;
}

.ivd-label {
  font-size: 24rpx;
  color: #64748b;
}

.ivd-mono {
  font-family: Menlo, Consolas, monospace;
  color: #374151;
}

.ivd-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
  text-align: center;
}

.ivd-back-btn {
  margin-top: 40rpx;
}
