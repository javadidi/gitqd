.ivs-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.ivs-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 44rpx;
  color: #ffffff;
  background: #16a34a;
  margin-bottom: 20rpx;
}

.ivs-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.ivs-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.ivs-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 26rpx;
}

.ivs-label {
  font-size: 24rpx;
  color: #64748b;
}

.ivs-mono {
  font-family: Menlo, Consolas, monospace;
  color: #374151;
}

.ivs-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #dc2626;
}

.ivs-status {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  color: #16a34a;
  background: #dcfce7;
}

.ivs-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
  text-align: center;
}

.ivs-detail-btn {
  margin-top: 40rpx;
}

.ivs-list-btn,
.ivs-home-btn {
  margin-top: 20rpx;
}
