<view class="page-invoice-list">
  <view class="container">
    <view class="card ivl-head">
      <text class="ivl-title">已开具电子发票</text>
      <text class="text-muted ivl-sub">共 {{rows.length}} 张</text>
    </view>

    <view wx:if="{{!loading && rows.length === 0}}" class="ivl-empty">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">还没有已开具的发票</view>
      <text class="text-muted empty-desc">在「待开具电子发票」里选一张已缴成功的缴费单即可开票</text>
      <button class="btn-outline ivl-pending-btn" bindtap="onGoPending">去开具</button>
    </view>

    <view
      wx:for="{{rows}}"
      wx:key="invoiceId"
      class="card ivl-card"
      data-id="{{item.invoiceId}}"
      bindtap="onOpen"
    >
      <view class="ivl-card-head">
        <text class="ivl-patient">{{item.patientName}}</text>
        <text class="ivl-status ivl-status-{{item.tone}}">{{item.statusLabel}}</text>
      </view>
      <view class="ivl-amount">{{item.amountText}}</view>
      <view class="text-muted ivl-no">{{item.invoiceNo}}</view>
      <view class="ivl-foot">
        <text class="text-muted ivl-time">{{item.timeText}} · 缴费单 {{item.paymentOrderNo}}</text>
        <text class="ivl-arrow">›</text>
      </view>
    </view>
  </view>
</view>
