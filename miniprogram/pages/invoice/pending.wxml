<view class="page-invoice-pending">
  <view class="container">
    <view class="card ivp-head">
      <text class="ivp-title">待开具电子发票</text>
      <text class="text-muted ivp-sub">共 {{rows.length}} 张可开票</text>
    </view>

    <view wx:if="{{!loading && rows.length === 0}}" class="ivp-empty">
      <view class="empty-icon">🧾</view>
      <view class="empty-title">暂无可开票的缴费记录</view>
      <text class="text-muted empty-desc">只有已缴成功、且还没开过票的缴费单会出现在这里</text>
      <button class="btn-outline ivp-pay-btn" bindtap="onGoPay">去缴费</button>
      <button class="btn-outline ivp-issued-btn" bindtap="onGoIssued">看已开具发票</button>
    </view>

    <view wx:for="{{rows}}" wx:key="paymentId" class="card ivp-card">
      <view class="ivp-card-head">
        <text class="ivp-patient">{{item.patientName}}</text>
        <text class="ivp-amount">{{item.amountText}}</text>
      </view>
      <view class="text-muted ivp-no">{{item.orderNo}}</view>
      <view class="ivp-foot">
        <text class="text-muted ivp-time">缴费时间 {{item.paidAtText}}</text>
        <button class="btn-primary ivp-issue-btn" size="mini" loading="{{submitting}}"
                data-id="{{item.paymentId}}" bindtap="onIssue">开票</button>
      </view>
    </view>
  </view>
</view>
