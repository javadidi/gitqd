<view class="page-doctor-detail">
  <view class="container">
    <view class="card">
      <view class="doctor-head-row">
        <view class="doctor-head-avatar">
          <image wx:if="{{avatar}}" class="doctor-head-img" src="{{avatar}}" mode="aspectFill" />
          <text wx:else>👨‍⚕️</text>
        </view>
        <view class="doctor-head-info">
          <view class="flex-row doctor-name-line">
            <text class="doctor-name-text">{{name}}</text>
            <text wx:if="{{titleName}}" class="doctor-rank">{{titleName}}</text>
          </view>
          <view class="doctor-head-dept">{{departmentName || '—'}}</view>
        </view>
      </view>

      <view class="doctor-field">
        <view class="text-muted">擅长领域</view>
        <view class="doctor-field-value">{{specialty || '暂无擅长信息'}}</view>
      </view>

      <view class="doctor-field">
        <view class="text-muted">医生简介</view>
        <view class="doctor-field-value">{{intro || '暂无简介'}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">出诊时间</view>

      <!-- T10 这页是纯只读（卡片 417 行红线「不做预约（T12）」）；T12 把预约落地后，
           每条排班多了挂号费与一个"去挂号"按钮，约满的行不给按钮。 -->
      <view wx:if="{{!loading && !hasSchedule}}" class="doctor-schedule-empty">
        <view class="empty-icon">📅</view>
        <view class="empty-title">近期暂无出诊安排</view>
        <view class="text-muted empty-desc">排班可能还没放出，换个医生或稍后再来</view>
        <button class="btn-outline doctor-schedule-empty-btn" bindtap="onBackToDepartment">返回上一页</button>
      </view>

      <view
        wx:for="{{schedules}}"
        wx:key="id"
        class="schedule-row {{item.booked ? 'schedule-row-booked' : ''}}"
      >
        <view class="schedule-date">
          <text class="schedule-date-day">{{item.date}}</text>
          <text class="schedule-date-weekday">{{item.weekday}}</text>
        </view>
        <view class="schedule-slot">{{item.slotLabel}}</view>
        <view class="schedule-slots">
          <text wx:if="{{item.booked}}" class="schedule-slots-booked">已约满</text>
          <text wx:else class="schedule-slots-left">余 {{item.remainingSlots}}/{{item.totalSlots}}</text>
        </view>
        <view class="schedule-fee">{{item.feeText}}</view>
        <view class="schedule-action">
          <button
            wx:if="{{!item.booked}}"
            class="btn-primary schedule-book-btn"
            size="mini"
            data-schedule="{{item}}"
            catchtap="onBook"
          >去挂号</button>
        </view>
      </view>
    </view>
  </view>
</view>
