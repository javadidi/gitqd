.page-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 48rpx;
  background: #fff;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.login-logo {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
}

.login-body {
  width: 100%;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.phone-login {
  width: 100%;
}

.input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #e5e5e5;
  border-radius: 44rpx;
  padding: 0 32rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.input-prefix {
  font-size: 30rpx;
  color: #333;
  margin-right: 16rpx;
  padding-right: 16rpx;
  border-right: 1rpx solid #e5e5e5;
}

.phone-input {
  flex: 1;
  font-size: 30rpx;
  margin-left: 16rpx;
}

.login-footer {
  position: fixed;
  bottom: 60rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  font-size: 22rpx;
}
