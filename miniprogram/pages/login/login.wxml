<view class="page-login">
  <view class="login-header">
    <text class="login-logo">🏥</text>
    <text class="login-title">医疗预约挂号</text>
    <text class="login-subtitle">便捷就医，从预约开始</text>
  </view>

  <view class="login-body">
    <button class="btn-primary login-btn" bindtap="onWechatLogin" loading="{{verifying}}">
      微信一键登录
    </button>
    <view class="login-tip">
      <text class="text-muted">首次登录后，请在「我的 - 手机号绑定」中绑定手机号</text>
    </view>
  </view>

  <view class="login-footer">
    <text class="text-muted">登录即表示同意</text>
    <text class="text-primary"> 《用户服务协议》</text>
    <text class="text-muted">和</text>
    <text class="text-primary"> 《隐私政策》</text>
  </view>
</view>
