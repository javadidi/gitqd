.mrd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.mrd-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.mrd-patient {
  font-size: 24rpx;
  color: #64748b;
}

.mrd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.mrd-label {
  font-size: 24rpx;
  color: #64748b;
}

.mrd-no {
  font-family: Menlo, Consolas, monospace;
  color: #374151;
}

.mrd-block {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1f5f9;
}

.mrd-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2937;
  white-space: pre-wrap;
}

.mrd-none {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.mrd-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #94a3b8;
  text-align: center;
}

.mrd-back-btn {
  margin-top: 40rpx;
}

.mrd-doctor-value,
.mrd-time-value {
  font-size: 26rpx;
  color: #1f2937;
}
