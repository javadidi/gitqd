.page-cd-apply {
  min-height: 100vh;
}

.cda-inpatient {
  position: relative;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cda-inpatient:last-of-type {
  border-bottom: none;
}

.cda-inpatient-on {
  background: #f8fbff;
}

.cda-inpatient-main {
  display: flex;
  align-items: baseline;
}

.cda-inpatient-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-right: 16rpx;
}

.cda-inpatient-no,
.cda-inpatient-ward {
  font-size: 24rpx;
}

.cda-inpatient-ward {
  margin-top: 6rpx;
}

.cda-inpatient-check {
  position: absolute;
  right: 8rpx;
  top: 24rpx;
  color: #2563eb;
  font-size: 32rpx;
}

.cda-empty {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.cda-empty-btn {
  margin-top: 24rpx;
}

.cda-field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cda-field-last {
  align-items: flex-start;
  border-bottom: none;
}

.cda-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
}

.cda-input {
  flex: 1;
  font-size: 28rpx;
}

.cda-textarea {
  flex: 1;
  height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.cda-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.cda-submit {
  margin-top: 40rpx;
}
