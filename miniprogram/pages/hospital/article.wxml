<view class="page-hospital">
  <view class="container">
    <view wx:if="{{detail}}" class="card">
      <view class="section-title">{{detail.title}}</view>
      <view class="hsp-body">{{detail.content}}</view>
      <view class="text-muted hsp-meta" wx:if="{{detail.hasTime}}">{{detail.timeText}}</view>
    </view>

    <view wx:if="{{!loading && !detail}}" class="card hsp-empty">
      <view class="empty-icon">📄</view>
      <view class="empty-title">读不到这篇内容</view>
      <view class="text-muted empty-desc">内容不存在，或已被医院下架</view>
    </view>
  </view>
</view>
