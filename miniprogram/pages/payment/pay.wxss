.ps-head {
  padding: 40rpx 24rpx;
  text-align: center;
}

.ps-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: #dcfce7;
  color: #16a34a;
  font-size: 48rpx;
  line-height: 88rpx;
}

.ps-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.ps-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.ps-items {
  margin-bottom: 8rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.ps-item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.ps-item-name {
  color: #4b5563;
}

.ps-item-amount {
  color: #1f2937;
}

.ps-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #1f2937;
}

.ps-row:last-child {
  border-bottom: none;
}

.ps-label {
  color: #9ca3af;
  font-size: 26rpx;
}

.ps-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #dc2626;
}

.ps-balance {
  color: #2563eb;
  font-weight: 600;
}

.ps-order {
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.ps-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.ps-records-btn {
  margin-top: 32rpx;
}

.ps-home-btn {
  margin-top: 20rpx;
}
